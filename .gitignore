# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / editors ---
.cursor/
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env.template
backend/.env

# Local Tushare doc sync credentials (see also backend/data/.gitignore)
backend/data/tushare_doc_credentials.json
backend/data/tushare_doc_storage.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
build/
dist/
*.manifest
*.spec

# Testing & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# --- Backend runtime artifacts ---
backend/logs/
*.log
backend/exports/
celerybeat-schedule
celerybeat.pid

# Vue SPA build output (frontend: npm run build → backend/static/)
backend/static/

# --- Frontend (Vue 3 + Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Playwright (optional doc-sync extra) ---
playwright-report/
test-results/
playwright/.cache/
.blob_storage/

# --- Project docs (local only, not versioned) ---
docs/
AGENTS.md

# --- Promo video assets (local generation output, see scripts/PROMO_MOVED.md) ---
promo_videos/

# --- Misc ---
*.bak
*.tmp
.cache/
